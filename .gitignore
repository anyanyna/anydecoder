target/
*.class

# anydecoder working directories
.anydecoder-work/
anydecoder-out/

# Scratch space. Session transcripts and corpus extracts have been landing here during
# development; none of it belongs in the repository, and some of it is not ours to publish.
_scratch/

# Nothing under validation/ is tracked except the scripts and the documentation. It is where a
# corpus is pointed at and where runs write: the corpus is a third party's compiled code and its
# decompilation is derived from it, so neither belongs in this repository.
validation/*
!validation/README.md
!validation/RESULTS.md
!validation/scripts/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project

# Machine-local Maven configuration. maven.config points at maven-settings.xml, which mirrors
# every repository to Maven Central because this machine's Maven installation redefines `central`
# as an unreachable internal Nexus. Committing it would override a contributor's own mirror,
# which is not this project's business to do.
.mvn/maven.config
.mvn/maven-settings.xml

# OS
.DS_Store
Thumbs.db
desktop.ini
