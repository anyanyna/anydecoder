target/
*.class

# anydecoder working directories
.anydecoder-work/
anydecoder-out/

# Scratch space. Session transcripts and corpus extracts have been landing here during
# development; none of it belongs in the repository, and some of it is not ours to publish.
_scratch/

# Nothing under validation/ is tracked except the documentation. It is where a
# corpus is pointed at and where runs write: the corpus is a third party's
# compiled code and its decompilation is derived from it, so neither belongs in
# this repository. Only the prose about how to run it does.
validation/*
!validation/README.md
!validation/RESULTS.md

